rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow reads and writes to the 'sessions' collection.
    // WARNING: Because this app does not use Firebase Authentication,
    // these rules are public. Anyone can read, create, update, or delete sessions.
    match /sessions/{sessionId} {
      allow read, write: if true;
      
      // Allow the presence collection to be updated
      match /presence/{deviceId} {
      	allow read, write: if true;
      }
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
