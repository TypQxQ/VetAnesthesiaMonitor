rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: This app does not use Firebase Authentication.
    // These rules are public. For production clinical use, add Firebase Auth
    // and restrict access to authenticated users only.

    // Sessions: allow create, read, update — but NOT delete.
    match /sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if false;
      
      // Presence subcollection: full access (app deletes on leave/unload)
      match /presence/{deviceId} {
      	allow read, write: if true;
      }
    }

    // Case history: full access (app creates and deletes archived cases)
    match /cases/{caseId} {
      allow read, write: if true;
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
